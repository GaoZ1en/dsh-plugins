{
  "name": "@koishi/dsh-chatgpt-message-style",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "description": "Blue-purple palette, right-aligned user bubbles with copy and timestamps, and a subtle reasoning border; follows official typography settings.",
  "license": "MIT",
  "engines": { "node": ">=22", "dsh": "0.2.1-rc.2" },
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lib/client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "VERIFICATION.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-client-ui-theme"]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/build.mjs && node --check lib/client.js && node --test test/*.test.mjs"
  }
}
